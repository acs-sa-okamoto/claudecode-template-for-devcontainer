{
  "name": "task-bridge",
  "version": "1.0.0",
  "description": "Claude Code が DevContainer 内で登録するタスクを Web UI で一覧表示し、Notion へブリッジする個人用ツール",
  "packageManager": "pnpm@10.34.1+sha512.b58fbde6dca66a929538021581f648b4570b6ca19b18e7cbd7f2c07a7b24454155388dacdf08f2af3678e88a6d1fe04f9d609df24bf51735a060ea041b374ab7",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "start": "node dist/server/index.js",
    "dashboard": "BEAM_DASHBOARD_MODE=view node --env-file-if-exists=.env dist/server/index.js",
    "build": "tsc -p tsconfig.json && pnpm run copy:assets && vite build",
    "build:server": "tsc -p tsconfig.json && pnpm run copy:assets",
    "copy:assets": "node --eval \"import('node:fs').then(fs => fs.cpSync('src/server/db/schema.sql', 'dist/server/db/schema.sql'))\"",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm run build:web && playwright test",
    "test:e2e:only": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "engines": {
    "node": "24.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "better-sqlite3": "^11.8.1",
    "hono": "^4.6.14",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@playwright/test": "^1.60.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.15.0",
    "eslint": "^9.27.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^3.1.2"
  }
}
