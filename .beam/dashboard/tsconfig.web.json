{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "noUncheckedIndexedAccess": true,

    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],

    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/web", "src/shared"],
  "exclude": ["node_modules", "dist"]
}
