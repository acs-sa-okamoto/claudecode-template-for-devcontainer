# task-bridge 環境変数サンプル
#
# このファイルをコピーして `.env` を作成し、各値を設定してください。
#   cp .env.example .env
# `.env` は .gitignore 済みで、シークレットは Git にコミットしません（REQ-405 / NFR-101）。
# 値の取得手順は docs/spec/task-bridge/prep.md を参照してください。
# 変数名は docs/spec/task-bridge/design/interfaces.ts の EnvConfig が正本です。

# Notion インテグレーションの Internal Integration Token（secret_... または ntn_...）
NOTION_API_TOKEN=

# プロジェクト DB を自動作成する親 Notion ページ ID（ハイフンなし 32 桁）
NOTION_PARENT_PAGE_ID=

# Claude Code が書き込むソース SQLite DB のパス（読取専用で開く）
SOURCE_DB_PATH=../../data/tasks.db

# Web サーバーのポート番号（既定: 3939、127.0.0.1 バインド）
PORT=3939

# アプリメタ DB のパス（任意。既定: data/app.db）
APP_DB_PATH=data/app.db
