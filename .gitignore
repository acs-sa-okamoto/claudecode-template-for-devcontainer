# =========================================================

# Direnv
.direnv/

# =========================================================
# Generated archives
# =========================================================
*.tgz

# =========================================================
# Misc
# =========================================================

# Claude local settings
.claude/settings.local.json
# アトミック書き込み（write temp → rename）の中間ファイル。名前が毎回変わるため
# ワイルドカードで除外する。これが無いと、書き込みと `git add -A` のタイミングが
# 重なった瞬間にローカル設定の一時ファイルがコミットされ得る。
.claude/settings.local.json.tmp.*

# Optional runtime files
*.pid
*.seed

# =========================================================
# Playwright E2E artifacts (TASK-0026)
# =========================================================
test-results/
playwright-report/
playwright/.cache/
